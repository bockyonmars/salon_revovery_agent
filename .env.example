NODE_ENV=development
HOST=127.0.0.1
PORT=4100
# JSON request/lifecycle logs are enabled automatically in production.
OPERATIONAL_LOGGING_ENABLED=false

# PostgreSQL. If omitted, the API uses the development-only MemoryStore.
DATABASE_URL=postgres://salon:salon@127.0.0.1:5432/salon_recovery
# Production may instead use standard node-postgres variables. This lets ECS inject
# RDS-managed username/password fields without constructing a secret connection URL.
PGHOST=
PGPORT=5432
PGDATABASE=salon_recovery
PGUSER=
PGPASSWORD=
PGSSLMODE=require
# Administrative connection to the same PostgreSQL server, using a different database.
# Required only for the disposable release-candidate backup/restore drill.
BACKUP_DRILL_ADMIN_URL=postgres://salon:salon@127.0.0.1:5432/postgres

# Clerk/Auth0-compatible JWT verification. Required in production.
AUTH_JWKS_URL=https://example.auth0.com/.well-known/jwks.json
AUTH_ISSUER=https://example.auth0.com/
AUTH_AUDIENCE=https://api.salon-recovery.example
# Comma-separated asymmetric algorithms and audiences are supported. RS256 is the secure default.
AUTH_ALLOWED_ALGORITHMS=RS256
AUTH_CLOCK_TOLERANCE_SECONDS=30
AUTH_MAX_TOKEN_AGE_SECONDS=3600
# Dot paths support nested Clerk/Auth0 custom claims. Defaults are shown.
AUTH_TENANT_CLAIM=tenant_id
AUTH_LOCATION_CLAIM=location_id
AUTH_USER_CLAIM=sub
AUTH_ROLE_CLAIM=role
# Map identity-provider role values to the four internal roles. Values cannot overlap.
AUTH_OWNER_ROLE_VALUES=owner
AUTH_MANAGER_ROLE_VALUES=manager
AUTH_OPERATOR_ROLE_VALUES=operator
AUTH_SERVICE_ROLE_VALUES=service
# Production always requires MFA evidence for the configured administrator roles.
# Standard amr values cover Auth0/Clerk-style ["pwd","otp"] and ["mfa"] claims.
# A factor such as otp is accepted only alongside another distinct authentication method.
AUTH_MFA_REQUIRED=false
AUTH_MFA_REQUIRED_ROLES=owner,manager
AUTH_MFA_AMR_CLAIM=amr
AUTH_MFA_AMR_VALUES=mfa,otp,hwk,swk
# Configure provider-specific acr assurance levels when your identity provider emits them.
AUTH_MFA_ACR_CLAIM=acr
AUTH_MFA_ACR_VALUES=

# Distributed tenant/location API budgets. Production always enables enforcement.
API_RATE_LIMIT_ENABLED=false
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_READ_REQUESTS=240
API_RATE_LIMIT_WRITE_REQUESTS=60

# Public acquisition form protection. Requests are bounded atomically across API replicas.
PUBLIC_REVIEW_RATE_LIMIT_WINDOW_SECONDS=3600
PUBLIC_REVIEW_RATE_LIMIT_REQUESTS=8
# Secret containing at least 32 random bytes, used only to HMAC source addresses before persistence.
PUBLIC_RATE_LIMIT_HASH_KEY=
# The AWS layout has one trusted ALB hop; change only when the ingress topology changes.
PUBLIC_TRUST_PROXY_HOPS=1
# Production always requires server-verified Cloudflare Turnstile evidence.
PUBLIC_BOT_PROTECTION_ENABLED=false
TURNSTILE_SECRET_KEY=
# Comma-separated public hostnames accepted from Siteverify, without schemes or paths.
TURNSTILE_EXPECTED_HOSTNAMES=salon-recovery.example
TURNSTILE_VERIFY_TIMEOUT_MS=5000
# Public site key embedded at frontend build time; pass it as a Docker build argument.
VITE_TURNSTILE_SITE_KEY=

# Protected release governance. References are opaque IDs, never report contents or URLs.
SECURITY_DEPENDENCY_REVIEW_AT=
SECURITY_DEPENDENCY_REVIEW_REF=
SECURITY_ACCESS_REVIEW_AT=
SECURITY_ACCESS_REVIEW_REF=
# Enterprise releases additionally require an independent penetration test from the last 366 days.
SECURITY_ENTERPRISE_RELEASE=false
SECURITY_PENETRATION_TEST_AT=
SECURITY_PENETRATION_TEST_REF=

# A reconciliation approval opens at this many verified findings; any critical finding always alerts.
RECONCILIATION_ALERT_FINDINGS=1

# Tenant-safe operations health thresholds. These affect alerts only; they never discard or mutate work.
OPERATIONS_OUTBOX_LAG_MS=300000
OPERATIONS_OUTBOX_BACKLOG_LIMIT=100
OPERATIONS_WORKFLOW_LAG_MS=300000
OPERATIONS_WORKFLOW_DUE_LIMIT=500
# Must stay aligned with the durable workflow lease-recovery boundary unless that contract is migrated.
OPERATIONS_WORKFLOW_LEASE_MS=300000

# Square sandbox first. Credentials must be encrypted at rest in production.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_API_VERSION=2026-07-15
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_OAUTH_REDIRECT_URI=http://127.0.0.1:4100/oauth/square/callback
CREDENTIAL_ENCRYPTION_KEY_BASE64=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://api.example.com/webhooks/square
# Development/test fallback only. Production resolves merchant_id from integration_accounts.
SQUARE_WEBHOOK_TENANT_ID=
SQUARE_WEBHOOK_LOCATION_ID=

# Release-candidate sandbox evidence. The mutation flag must be explicitly enabled for a smoke run.
# The Square appointment must be a real available sandbox slot at least 15 minutes in the future.
SANDBOX_ALLOW_PROVIDER_MUTATIONS=false
SANDBOX_PERSIST_ONBOARDING_EVIDENCE=false
SANDBOX_TENANT_ID=
SANDBOX_LOCATION_ID=
SANDBOX_SQUARE_LOCATION_ID=
SANDBOX_SQUARE_CUSTOMER_ID=
SANDBOX_SQUARE_TEAM_MEMBER_ID=
SANDBOX_SQUARE_SERVICE_VARIATION_ID=
SANDBOX_SQUARE_SERVICE_VARIATION_VERSION=
SANDBOX_SQUARE_DURATION_MINUTES=60
SANDBOX_SQUARE_START_AT=
SANDBOX_WEBHOOK_WAIT_SECONDS=30

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS sender in plain E.164 format, for example +15555550100.
TWILIO_FROM_NUMBER=
# WhatsApp sender in E.164 format, with or without the whatsapp: prefix.
TWILIO_WHATSAPP_FROM_NUMBER=
TWILIO_STATUS_CALLBACK_URL=https://api.example.com/webhooks/twilio/status
TWILIO_INBOUND_WEBHOOK_URL=https://api.example.com/webhooks/twilio/inbound
TWILIO_VOICE_STATUS_WEBHOOK_URL=https://api.example.com/webhooks/twilio/voice/status
TWILIO_VOICE_INBOUND_WEBHOOK_URL=https://api.example.com/webhooks/twilio/voice/inbound
# Development/test fallback only. Production resolves the signed To address from channel_routes.
TWILIO_WEBHOOK_TENANT_ID=
TWILIO_WEBHOOK_LOCATION_ID=
# A controlled test handset. Prefix this value with whatsapp: to verify through TWILIO_WHATSAPP_FROM_NUMBER;
# use a plain E.164 value to verify through TWILIO_FROM_NUMBER.
# `sandbox:smoke` sends one non-customer verification message and may incur provider charges.
SANDBOX_TWILIO_TO=
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=4200
WORKER_ID=workflow-worker-1
WORKER_POLL_MS=1000
WORKER_BATCH_SIZE=20
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=4300
# Readiness fails when one workflow tick exceeds this duration.
WORKER_STALL_MS=120000
# SIGTERM waits this long for an active tick before durable recovery takes over.
WORKER_SHUTDOWN_GRACE_MS=25000

# Optional Responses API conversation router. Without a key, safe deterministic routing and operator drafts remain available.
OPENAI_API_KEY=
MODEL_CONCIERGE=gpt-5.6-terra
OPENAI_TIMEOUT_MS=20000
# Opt-in conversational telephony. Configure the provider SIP trunk to OpenAI's project SIP URI,
# then configure the OpenAI project webhook to POST signed events to /webhooks/openai/realtime.
# Production calls still fail closed unless the location has current readiness, sandbox evidence, and owner activation.
OPENAI_REALTIME_SIP_ENABLED=false
OPENAI_WEBHOOK_SECRET=
# Pinned and reviewed independently from the text concierge model.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# SIP header containing the called salon E.164 number. `to` is the default; override for trunk-specific headers.
OPENAI_SIP_DESTINATION_HEADER=to
# Controlled staging-call evidence. Evaluation reads the redacted call-control ledger; it never places a call.
# The bootstrap is ignored in production and must target a dedicated non-production number and exact tenant/location.
# Enable it only for the controlled call, then disable it immediately.
VOICE_SANDBOX_ALLOW_CONTROLLED_CALL=false
VOICE_SANDBOX_DESTINATION=
VOICE_SANDBOX_ALLOW_EVALUATION=false
VOICE_SANDBOX_TENANT_ID=
VOICE_SANDBOX_LOCATION_ID=
VOICE_SANDBOX_CALL_ID=
VOICE_SANDBOX_MAX_AGE_MINUTES=30
# Use a new filename for every attempt; evidence files are write-once.
VOICE_SANDBOX_EVIDENCE_OUTPUT=release-evidence/voice-sandbox-unique.json
# Full release evaluation makes 144 bounded router calls only after this explicit cost acknowledgement.
EVAL_ALLOW_MODEL_CALLS=false
EVAL_PERSIST_TO_DATABASE=false
# Optional write-once evidence path under release-evidence/.
EVAL_EVIDENCE_OUTPUT=
# Protected prompt activation. Set true only after reviewing a fresh, exact-digest model evaluation.
PROMPT_RELEASE_APPROVED=false
# Opaque approval or change-ticket reference; never paste report contents or a secret here.
PROMPT_RELEASE_APPROVAL_REFERENCE=

# Weekly verified-revenue report delivery. The From address must be a confirmed Postmark sender.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=reports@example.com

# Stripe Billing. Checkout return URLs are server-owned; subscription metadata binds webhooks to tenant/location.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
BILLING_TRIAL_DAYS=14
BILLING_SUCCESS_URL=http://127.0.0.1:5173/?billing=success
BILLING_CANCEL_URL=http://127.0.0.1:5173/?billing=cancelled
BILLING_ENFORCEMENT_ENABLED=false

# Production enables this automatically. New automation remains paused until onboarding tests pass and a manager activates the location.
ONBOARDING_ENFORCEMENT_ENABLED=false

# Dashboard-to-API development bridge. Never embed a production bearer token in Vite output.
VITE_API_BASE_URL=
VITE_DEV_AUTH_TOKEN=dev:tenant-one:location-one:manager-one:manager
# Production dashboard OIDC. These are public build-time values; never add a client secret.
DASHBOARD_PUBLIC_ORIGIN=https://salon-recovery.example
VITE_OIDC_AUTHORITY=https://example.auth0.com/
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=https://salon-recovery.example/app/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=https://salon-recovery.example/app
VITE_OIDC_SCOPE=openid profile email
# Optional OAuth resource/audience request when required by the identity provider.
VITE_OIDC_RESOURCE=https://api.salon-recovery.example
