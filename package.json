{
  "name": "salon-recovery-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && npm run build:api && vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "start:api": "node dist-server/index.js",
    "start:webhooks": "node dist-server/webhook-index.js",
    "start:worker": "node dist-server/workflow-index.js",
    "dev:webhooks": "tsx watch server/webhook-index.ts",
    "dev:worker": "tsx watch server/workflow-index.ts",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:migrate:prod": "node dist-server/db/migrate.js",
    "db:restore:drill": "node --import tsx server/scripts/database-restore-drill.ts",
    "sandbox:preflight": "node --import tsx server/scripts/provider-sandbox-smoke.ts",
    "sandbox:smoke": "node --import tsx server/scripts/provider-sandbox-smoke.ts --execute",
    "voice:sandbox:preflight": "node --import tsx server/scripts/validate-voice-sandbox.ts",
    "voice:sandbox:evaluate": "node --import tsx server/scripts/validate-voice-sandbox.ts --evaluate",
    "voice:release:payload": "node --import tsx server/scripts/prepare-voice-release-evidence.ts",
    "bot:preflight": "node --import tsx server/scripts/validate-public-bot-protection.ts",
    "auth:preflight": "node --import tsx server/scripts/validate-dashboard-auth.ts",
    "security:preflight": "node --import tsx server/scripts/validate-security-governance.ts",
    "release:validate": "node --import tsx server/scripts/validate-release-candidate.ts",
    "release:validate:local": "node --import tsx server/scripts/validate-release-candidate.ts --local-only",
    "eval:golden": "node --import tsx server/scripts/run-golden-evals.ts",
    "eval:golden:model": "node --import tsx server/scripts/run-golden-evals.ts --model",
    "prompt:activate": "node --import tsx server/scripts/activate-conversation-prompt.ts",
    "prompt:activate:prod": "node dist-server/scripts/activate-conversation-prompt.js",
    "test": "vitest run --pool=vmThreads --maxWorkers=1 --no-file-parallelism",
    "test:reliability": "vitest run server/reliability.test.ts",
    "test:watch": "vitest",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@phosphor-icons/react": "^2.1.10",
    "fastify": "^5.10.0",
    "fastify-raw-body": "^5.0.0",
    "jose": "^6.2.3",
    "oidc-client-ts": "^3.5.0",
    "openai": "^7.0.0",
    "pg": "^8.22.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "square": "^45.0.1",
    "stripe": "^22.3.2",
    "twilio": "^6.0.2",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.4",
    "vitest": "^4.1.10"
  }
}
